{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["tekton", "dockerfile", "rpm-lockfile", "gomod"],
  "extends": [
    "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "recreateWhen": "always",
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "Group Kubernetes Go modules (k8s.io, sigs.k8s.io) with generic-admission-server, whose go.mod directly requires k8s.io modules at the Kubernetes minor it targets",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "k8s.io/**",
        "sigs.k8s.io/**",
        "github.com/openshift/generic-admission-server"
      ],
      "groupName": "Kubernetes Go dependencies"
    },
    {
      "description": "Group the OpenShift baremetal-operator fork root and submodules, which go.mod uses as replace targets that Renovate updates by digest",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "github.com/openshift/baremetal-operator",
        "github.com/openshift/baremetal-operator/**"
      ],
      "groupName": "baremetal-operator Go dependencies"
    },
    {
      "description": "Enable and group updates for the OpenTelemetry Go stable-v1 modules in go.mod, which upstream releases together at one shared version; they are indirect requirements, which Renovate does not update by default. Other indirect modules, including OpenTelemetry auto, contrib and proto, are still not updated",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "go.opentelemetry.io/otel",
        "go.opentelemetry.io/otel/exporters/otlp/otlptrace",
        "go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc",
        "go.opentelemetry.io/otel/metric",
        "go.opentelemetry.io/otel/sdk",
        "go.opentelemetry.io/otel/sdk/metric",
        "go.opentelemetry.io/otel/trace"
      ],
      "enabled": true,
      "groupName": "OpenTelemetry Go stable modules"
    }
  ]
}
